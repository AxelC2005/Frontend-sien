<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-center justify-between py-3 gap-4">
      <!-- Logo y Título -->
      <div class="flex items-center space-x-3.5">
        <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-blue-700 to-indigo-600 flex items-center justify-center text-white shadow-md shadow-blue-600/20">
          <i class="fa-solid fa-staff-snake text-xl" aria-hidden="true"></i>
        </div>
        <div>
          <div class="flex items-center gap-2.5">
            <h1 class="font-extrabold text-xl leading-tight text-slate-900 tracking-tight">SIEN-HIS 2025</h1>
            <span class="px-2.5 py-0.5 text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 rounded-full">
              Adolescentes 12-17 años
            </span>
          </div>
          <p class="text-xs text-slate-500 font-medium mt-0.5">
            Vigilancia Antropométrica, Clustering K-Means & Inferencia vía API
          </p>
        </div>
      </div>

      <!-- Indicadores Rápidos y Estado de API -->
      <div class="flex items-center flex-wrap gap-2.5 text-xs">
        <div class="flex items-center gap-2 bg-slate-50 px-3 py-2 rounded-xl border border-slate-200 text-slate-700">
          <i class="fa-solid fa-database text-blue-600" aria-hidden="true"></i>
          <span>Muestra: <strong class="font-mono text-slate-900">1,250,980</strong></span>
        </div>
        <div class="flex items-center gap-2 bg-slate-50 px-3 py-2 rounded-xl border border-slate-200 text-slate-700">
          <i class="fa-solid fa-map-location-dot text-indigo-600" aria-hidden="true"></i>
          <span>Provincias: <strong class="font-mono text-slate-900" id="header-prov-count">197</strong></span>
        </div>
        <div id="api-status-badge" class="flex items-center gap-2 bg-amber-50 text-amber-800 px-3.5 py-2 rounded-xl border border-amber-200 font-bold">
          <span id="api-status-dot" class="w-2.5 h-2.5 rounded-full bg-amber-500 animate-pulse"></span>
          <span id="api-status-text">Conectando API...</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Barra de Pestañas Tailwind (Espaciadas en Grid/Flex con tarjetas individuales) -->
  <nav class="border-t border-slate-200 bg-slate-50/90 px-4 py-2.5" aria-label="Navegación de pestañas">
    <div role="tablist" class="max-w-7xl mx-auto grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5">
      <button role="tab" aria-selected="true" data-tab-target="tab-calculadora" class="tab-btn w-full px-3.5 py-2.5 rounded-xl text-xs font-bold border border-slate-200 bg-white text-slate-700 hover:bg-blue-50/50 hover:border-blue-300 transition flex items-center justify-center gap-2 shadow-sm">
        <i class="fa-solid fa-stethoscope text-sm" aria-hidden="true"></i>
        <span>Evaluador & API</span>
      </button>
      <button role="tab" aria-selected="false" data-tab-target="tab-resumen" class="tab-btn w-full px-3.5 py-2.5 rounded-xl text-xs font-bold border border-slate-200 bg-white text-slate-700 hover:bg-blue-50/50 hover:border-blue-300 transition flex items-center justify-center gap-2 shadow-sm">
        <i class="fa-solid fa-chart-pie text-sm" aria-hidden="true"></i>
        <span>Resumen Ejecutivo</span>
      </button>
      <button role="tab" aria-selected="false" data-tab-target="tab-kmeans" class="tab-btn w-full px-3.5 py-2.5 rounded-xl text-xs font-bold border border-slate-200 bg-white text-slate-700 hover:bg-blue-50/50 hover:border-blue-300 transition flex items-center justify-center gap-2 shadow-sm">
        <i class="fa-solid fa-diagram-project text-sm" aria-hidden="true"></i>
        <span>Modelo K-Means</span>
      </button>
      <button role="tab" aria-selected="false" data-tab-target="tab-provincial" class="tab-btn w-full px-3.5 py-2.5 rounded-xl text-xs font-bold border border-slate-200 bg-white text-slate-700 hover:bg-blue-50/50 hover:border-blue-300 transition flex items-center justify-center gap-2 shadow-sm">
        <i class="fa-solid fa-ranking-star text-sm" aria-hidden="true"></i>
        <span>Ranking Provincial</span>
      </button>
      <button role="tab" aria-selected="false" data-tab-target="tab-genero" class="tab-btn w-full px-3.5 py-2.5 rounded-xl text-xs font-bold border border-slate-200 bg-white text-slate-700 hover:bg-blue-50/50 hover:border-blue-300 transition flex items-center justify-center gap-2 shadow-sm">
        <i class="fa-solid fa-venus-mars text-sm" aria-hidden="true"></i>
        <span>Análisis de Género</span>
      </button>
      <button role="tab" aria-selected="false" data-tab-target="tab-politicas" class="tab-btn w-full px-3.5 py-2.5 rounded-xl text-xs font-bold border border-slate-200 bg-white text-slate-700 hover:bg-blue-50/50 hover:border-blue-300 transition flex items-center justify-center gap-2 shadow-sm">
        <i class="fa-solid fa-bullseye text-sm" aria-hidden="true"></i>
        <span>Políticas Públicas</span>
      </button>
    </div>
  </nav>
</header>